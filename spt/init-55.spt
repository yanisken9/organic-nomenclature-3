 set antialiasDisplay on;

 set antialiasImages ON;

 set labelOffset 0 0; 
 font labels 18; 
 color labels black;

  font echo 28; 
 color echo [xA4031F];

 color selectionHalos[X66ff66] ;

 select all and not _Xx; 
 spacefill 24%; 
 wireframe 0.13;

 hover off;
 
 background [xffffff]

 frank off;

 rotate best;
 
 zoom 0;

 zoomto 0.0 out;

 




# v55 local minimization tuning from professor5ab2495; geometry quality remains provisional.
set minimizationCriterion 0.01;
