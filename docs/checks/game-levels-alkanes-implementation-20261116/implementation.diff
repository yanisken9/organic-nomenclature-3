+/* Shared level controls; deliberately scoped for standalone and lesson hosts. */
+.nl-game-levels{box-sizing:border-box;max-width:1100px;margin:14px auto 20px;padding:16px;border:1px solid #b8d2c8;border-radius:18px;background:#f2f8f4;color:#254c50;font:inherit;text-align:left}
