+.nl-game-levels__button{display:flex;flex-direction:column;align-items:flex-start;gap:5px;min-width:0;min-height:116px;padding:13px 14px;border:2px solid #b4d0c4;border-radius:13px;background:#fff;color:#254c50;font:inherit;line-height:1.4;text-align:left;white-space:normal;overflow-wrap:anywhere;cursor:pointer;opacity:1}
