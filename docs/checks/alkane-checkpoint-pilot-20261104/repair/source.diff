+.nl-repair-round .session-row .quiet { font-size: 11.04px; min-height: 40px; padding: 7px 10px; }
+
+
+.nl-repair-round .zoom-dialog { width: calc(100% - 32px); max-width: 1050px; max-height: calc(100dvh - 32px); border: 1px solid #c6d9cd; border-radius: 20px; padding: 20px; background: var(--paper); color: var(--ink); }
+.nl-repair-round .zoom-heading { display: flex; justify-content: space-between; align-items: center; gap: 15px; }
+.nl-repair-round .zoom-heading h2 { font-size: 16px; margin: 0; }
+.nl-repair-round .zoom-dialog p { color: var(--muted); font-size: 12.16px; margin: 12px 0; }
+.nl-repair-round .zoom-viewport { max-height: calc(100dvh - 210px); overflow: auto; overscroll-behavior: contain; border: 1px solid var(--line); background: #fff; border-radius: 10px; padding: 20px; }
+.nl-repair-round .zoom-image { display: block; width: auto; max-width: none; height: auto; margin: auto; }
+
+
+.nl-repair-round .bench { grid-template-columns: minmax(0, .95fr) minmax(0, 1.13fr); }
+.nl-repair-round .round-heading h1 { overflow-wrap: anywhere; }
