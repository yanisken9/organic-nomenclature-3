+.nl-repair-round .choices { display: flex; flex-wrap: wrap; gap: 7px; }
+.nl-repair-round .choice-button { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 9px 13px; border: 1px solid #c4d3c9; border-radius: 10px; color: var(--ink); background: white; font-size: 13.6px; font-weight: 600; }
+.nl-repair-round .choice-button::before { content: ""; height: 14px; width: 14px; border-radius: 50%; border: 1px solid #a3baae; background: white; flex-shrink: 0; }
+.nl-repair-round .choice-button[aria-pressed="true"] { border-color: var(--teal-dark); background: var(--mint); }
+.nl-repair-round .choice-button[aria-pressed="true"]::before { border: 4px solid var(--teal-dark); }
