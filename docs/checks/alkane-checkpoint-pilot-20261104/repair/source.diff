+.nl-repair-round .quiet:hover:not(:disabled) { background: #e9efea; color: var(--ink); }
+
+.nl-repair-round .workshop-logo-small { display: block; width: 36px; height: 36px; object-fit: contain; flex: 0 0 auto; }
+.nl-repair-round .round-topbar .round-game-brand { display: flex; align-items: center; gap: 10px; margin: 0; }
+.nl-repair-round .round-game-label { min-width: 0; }
+
+.nl-repair-round .round-topbar { display: flex; align-items: center; gap: 20px; justify-content: space-between; margin-bottom: 27px; }
+.nl-repair-round .round-topbar .eyebrow { margin: 0; }
+.nl-repair-round .round-heading { margin-bottom: 22px; }
+.nl-repair-round .round-heading h1 { font-size: clamp(28.8px, 3vw, 40px); letter-spacing: -.04em; margin-bottom: 10px; }
+.nl-repair-round .round-heading p { color: var(--muted); max-width: 810px; font-size: 14.72px; margin: 0; }
+.nl-repair-round .round-heading .guided-pill { margin-bottom: 9px; }
+.nl-repair-round .guided-pill { display: inline-block; border-radius: 99px; padding: 3px 10px; background: var(--mint); font-weight: 700; color: var(--teal-dark); font-size: 10.56px; }
+.nl-repair-round .compact-steps { display: flex; flex-wrap: wrap; gap: 6px 18px; list-style: none; padding: 0; margin: 0 0 22px; font-size: 11.52px; color: var(--muted); }
