+.nl-repair-round .image-status .secondary { min-height: 40px; font-size: 12.16px; padding: 8px 12px; }
+.nl-repair-round .repair-card { background: white; border: 1px solid var(--line); border-radius: 21px; padding: 22px; box-shadow: var(--shadow); }
+.nl-repair-round .repair-card .section-label { display: block; margin-bottom: 8px; color: var(--peach-ink); font-size: 10.56px; font-weight: 800; letter-spacing: .04em; }
+.nl-repair-round .broken-name { background: #fbf2e9; border: 1px dashed #dfc5ac; border-radius: 12px; padding: 13px 14px; font-size: clamp(16.48px, 1.7vw, 19.2px); font-weight: 650; overflow-wrap: anywhere; line-height: 1.5; margin-bottom: 22px; }
+.nl-repair-round .step-heading { font-size: 13.6px; margin: 0 0 5px; }
