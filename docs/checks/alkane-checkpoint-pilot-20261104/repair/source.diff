+.nl-repair-round .candidate { margin: 0 0 17px; padding: 11px 13px; background: #f2f7f3; border: 1px solid #dde9df; border-radius: 10px; }
+.nl-repair-round .candidate-label { display: block; font-size: 10.08px; color: var(--muted); margin-bottom: 3px; }
+.nl-repair-round .candidate-name { display: block; font-size: 15.52px; font-weight: 700; overflow-wrap: anywhere; }
+.nl-repair-round .repair-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
