+/* Embedded repair round only; the standalone theme remains independent. */
+.nl-repair-round {
+  color-scheme: light;
+  --ink: #254c50;
+  --teal: #397b78;
+  --teal-dark: #245f5c;
+  --muted: #526e6e;
+  --paper: #faf9f5;
+  --mint: #e1efea;
+  --mint-deep: #c4dfd4;
+  --peach: #f7dfcf;
+  --peach-ink: #81492c;
+  --line: #d9e3dd;
+  --white: #fff;
+  --shadow: 0 16px 45px #254c5009;
+  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  font-size: 16px;
+  line-height: 1.6;
+  color: var(--ink);
+  background: var(--paper);
+  width: 100%;
+  min-width: 0;
+  container-type: inline-size;
+  container-name: nl-repair;
+}
+.nl-repair-round, .nl-repair-round * { box-sizing: border-box; }
+.nl-repair-round [hidden] { display: none !important; }
+.nl-repair-round button { font: inherit; cursor: pointer; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
+.nl-repair-round button:disabled { cursor: default; opacity: .5; }
+.nl-repair-round button:focus-visible, .nl-repair-round [tabindex]:focus-visible { outline: 3px solid #a54e2e; outline-offset: 4px; }
+.nl-repair-round h1, .nl-repair-round h2, .nl-repair-round p { margin-top: 0; }
+.nl-repair-round h1 { display: block; line-height: 1.12; }
+.nl-repair-round h2 { line-height: 1.35; letter-spacing: -.025em; }
+.nl-repair-round p { margin-bottom: 16px; }
+
+.nl-repair-round .eyebrow { display: block; margin: 0 0 15px; color: var(--teal-dark); font-size: 10.56px; line-height: 1.5; letter-spacing: .15em; font-weight: 800; }
+
+.nl-repair-round .primary, .nl-repair-round .secondary, .nl-repair-round .quiet { display: inline-flex; align-items: center; justify-content: center; gap: 12px; min-height: 47px; border-radius: 12px; padding: 11px 21px; border: 1px solid transparent; font-size: 14.08px; font-weight: 700; text-decoration: none; line-height: 1.4; }
+.nl-repair-round .primary { background: var(--ink); color: white; }
+.nl-repair-round .primary:hover:not(:disabled) { background: var(--teal-dark); }
