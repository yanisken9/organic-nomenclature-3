+.nl-repair-round .diagram-tools .quiet { min-height: 35px; padding: 5px 8px; font-size: 10.4px; border: 1px solid var(--line); }
+.nl-repair-round .diagram-figure { margin: 0; padding: 18px 17px 13px; }
+.nl-repair-round .diagram-stage { display: grid; place-items: center; min-height: 230px; border-radius: 12px; background-color: #fdfdfa; background-image: radial-gradient(#d9e1d5 .65px, transparent .65px); background-size: 14px 14px; }
+.nl-repair-round .diagram-image { width: auto; max-width: 100%; height: auto; object-fit: contain; display: block; background: #fdfdfa; border-radius: 10px; }
