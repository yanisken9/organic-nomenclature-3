+.nl-repair-round .part-button:hover:not(:disabled) { border-color: var(--teal); background: var(--mint); }
+.nl-repair-round .part-button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: white; box-shadow: 0 0 0 3px #e1efea; }
+.nl-repair-round .part-button.is-agreeing { background: var(--mint); border-color: #a4c5b5; color: var(--teal-dark); }
