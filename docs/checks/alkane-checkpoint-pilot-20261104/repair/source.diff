+.nl-repair-round .card-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 17px 20px; border-bottom: 1px solid #edf0ea; }
+.nl-repair-round .card-heading h2 { font-size: 13.6px; margin: 0; }
+.nl-repair-round .card-heading span { color: var(--muted); font-size: 10.4px; }
