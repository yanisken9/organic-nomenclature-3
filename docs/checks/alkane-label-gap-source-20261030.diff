+function fPadExpandedAlkaneBranchLabels() {
+  // Keep native atom anchors/bond geometry. Only the existing white masks at
+  // vertical C-C endpoints need a small clearance around the rendered C.
+  if (mode2D !== "expanded" ||
+      nameExamples[selectedMol]?.classification?.seriesKey !== "alkanes") return;
+  const texts = fGetRenderedAtomTextMap(false, true);
+  const rects = fGetRenderedAtomRectMap(false, true);
+  const endpoints = new Set();
+  for (const [a, b, order] of bondList) {
+    if (order !== 1 || allAtomsTypeList[a - 1] !== "C" ||
+        allAtomsTypeList[b - 1] !== "C") continue;
+    const first = texts[a - 1], second = texts[b - 1];
+    if (!first || !second) continue;
+    const dx = Number(first.attr("x")) - Number(second.attr("x"));
+    const dy = Number(first.attr("y")) - Number(second.attr("y"));
+    if (Math.abs(dx) < 0.01 && Math.abs(dy) > 0.01) {
+      endpoints.add(a - 1);
+      endpoints.add(b - 1);
+    }
+  }
+  for (const atomIdx of endpoints) {
+    const label = texts[atomIdx], backplate = rects[atomIdx];
+    if (!label || !backplate || label.node.textContent.trim() !== "C") continue;
+    // Convert actual font bounds back into JSME's local drawing coordinates,
+    // as for expanded carboxyl labels. Recomputed on every rebuild/fit.
+    const screen = label.node.getBoundingClientRect();
+    const matrix = label.node.getScreenCTM();
+    if (!matrix) continue;
+    const inverse = matrix.inverse();
+    const corners = [[screen.left, screen.top], [screen.right, screen.top],
+      [screen.left, screen.bottom], [screen.right, screen.bottom]].map(xy => {
+      const point = label.node.ownerSVGElement.createSVGPoint();
+      point.x = xy[0]; point.y = xy[1];
+      return point.matrixTransform(inverse);
+    });
+    const left = Math.min(...corners.map(p => p.x));
+    const top = Math.min(...corners.map(p => p.y));
+    const right = Math.max(...corners.map(p => p.x));
+    const bottom = Math.max(...corners.map(p => p.y));
+    const fontSize = parseFloat(label.attr("font-size"));
+    if (!Number.isFinite(fontSize) || fontSize <= 0 ||
+        ![left, top, right, bottom].every(Number.isFinite) ||
+        right <= left || bottom <= top) continue;
+    const padding = fontSize * 0.06;
+    // Preserve horizontal masking; only the vertical clearance is adjusted.
+    backplate.attr({y: top - padding, height: bottom - top + 2 * padding});
+  }
+}
