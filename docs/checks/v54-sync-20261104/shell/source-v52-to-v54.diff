+   lay out in a row inside it, mirroring #viewerVisBtns on the left. */
+#viewerSettingsBtnDiv {
+  position: absolute;
+  right: 8px;
+  top: 50%;
+  transform: translateY(-50%);
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  z-index: 300;
+}
+
+#viewerSettingsBtnDiv .settingsBtn {
+  position: static;
+  transform: none;
+}
+
+/* Molecule draft bar (v54 Stage 2): [status … Submit][Cancel] row between the
