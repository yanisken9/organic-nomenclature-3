+
+/* The bar's closed/presenting state lives on #scenarioAuthorBar
+   (visibility:hidden + pointer-events:none), but an open drawer sets
+   visibility:visible/pointer-events:auto on itself and would escape it.
+   Keep the drawer's .open state and scroll while the bar is away, yet hide
+   it from view, hit testing and the tab order. The visibility delay matches
+   the bar slide so the open drawer rides out with it, then disappears;
+   reopening shows it instantly at the same scroll. */
+#scenarioAuthorBar:not(.open) .scenarioDrawer,
+#scenarioAuthorBar.is-hidden .scenarioDrawer {
+   visibility: hidden;
+   pointer-events: none;
+   transition: visibility 0s linear .25s;
+}
