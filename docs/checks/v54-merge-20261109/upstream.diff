+/* Pinned drawer fills the bar (v48): the open drawer's card becomes a flex
+   column claiming leftover bar height (bar itself stretches to
+   pageContainer's bottom), and the open drawer scrolls internally instead of
+   pushing the panels container. Only the accordion-open card grows (:has,
+   no JS change). Grow animation becomes instant-tall + fade (max-height
+   can't transition to none); unpinned keeps today's slide-down. */
+body.scPinned .scenarioPanel:has(.scenarioDrawer.open) {
+   flex: 1 1 auto;
+   min-height: 85vh;
+   display: flex;
+   flex-direction: column;
+}
