+/* Shared tooltip skin (single copy): text look for every [data-tooltip]
+   bubble on the page — panel buttons, eye toggles, author tab, pick toggle,
+   scenario bar/panel/step/toolbar buttons, type badge, drag handle.
+   Geometry (position/top/left/transform) and z-index stay in the per-family
+   rules below and in css/mulermoc-nom-scenario-52.css. Both stylesheets
+   always load together via mulermoc-nom-52.html, so scenario selectors are
+   covered here and not re-declared there. */
+.narrateBtn[data-tooltip]::after,
+.readNameBtn[data-tooltip]::after,
+.viewerToolBtn[data-tooltip]::after,
+.stepBtn[data-tooltip]::after,
+.settingsBtn[data-tooltip]::after,
+.nameStyleBox[data-tooltip]::after,
+.nameStyleCross[data-tooltip]::after,
+.nameStyleEye[data-tooltip]::after,
+.nameStyleExpand[data-tooltip]::after,
+.molInfoCopy[data-tooltip]::after,
+#narrateAnalysisToggle[data-tooltip]::after,
+.compEye[data-tooltip]::after,
+#scenarioAuthorTab[data-tooltip]::after,
+#nomeclature2Menu .panelTitle #scPickToggle.unselectedCheck[data-tooltip]::after,
+#nomeclature2Menu .panelTitle #scPickToggle.selectedCheck[data-tooltip]::after,
+#scenarioPlayBarTitle button[data-tooltip]::after,
+#scenarioPlayBar button[data-tooltip]::after,
+.scenarioPanel button[data-tooltip]::after,
