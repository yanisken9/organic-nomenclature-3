+/* Presentation-only overrides (JS flips #pageContainer.presenting; display
+   authority stays here so present styling survives menu/name rebuilds). */
+/* Present layout: pack title/step text/app at the top and pin the credits
+   footer to the bottom. Base #pageContainer uses justify-content:space-between
+   (jsme-nick-52.css), which spreads every child across the full height; here
+   the last child's margin-top:auto absorbs the free space instead, so the
+   footer stays on the bottom without spreading the rest. The chain below
+   (authorLayout > mainAppContainer > mainApp3Columns) is flex:1 so the row
+   fills the viewport down to the credits; side rails stretch into that
+   height and internal-scroll (see fScenarioSyncStepTextHeight). */
+#pageContainer.presenting {
+   justify-content: flex-start;
+   height: auto;
+   min-height: calc(100vh - 30px);
+}
+
+#pageContainer.presenting #authorLayout {
+   flex: 1 0 auto;
+   display: flex;
+   flex-direction: column;
+   min-height: 0;
+   width: 100%;
+}
+
+#pageContainer.presenting #mainAppContainer {
+   flex: 1 0 auto;
+   display: flex;
+   flex-direction: column;
+   min-height: 0;
+   width: 100%;
+}
+
+#pageContainer.presenting #mainAppContainer > .mainApp3Columns {
+   flex: 1 0 auto;
+   min-height: 0;
+}
