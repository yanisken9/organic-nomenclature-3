+/* Presentation top text: span exactly the visible app columns. JS measures the
+   union of the visible menu/viewer/analysis columns and sets these vars; the
+   fallbacks keep the old full-width behavior if measurement is unavailable.
+   The side-rail rules below move the card out of #authorLayout, so they never
+   match this selector. */
+#pageContainer.presenting #authorLayout > #scStepText {
+   width: var(--scStepTextFitWidth, 100%);
+   margin-left: var(--scStepTextFitLeft, auto);
+   margin-right: auto;
+   max-width: 100%;
