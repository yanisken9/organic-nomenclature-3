+/* Viewer title-bar button rows: left [2D][3D], right [edit][new][save][gear].
+   Buttons lay out in a row; .settingsBtn absolute positioning is
+   neutralized inside both containers. */
+#viewerVisBtns {
+  position: absolute;
+  left: 16px;
+  top: 50%;
+  transform: translateY(-50%);
+  display: flex;
+  align-items: center;
