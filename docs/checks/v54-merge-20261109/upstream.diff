+/* mulermoc-nom-scenario-52.css — didactic-scenario chrome (author bar, drawer, playback bar, step text).
+   Moved out of fScenarioInjectCss so formats are designed here, not in JS. */
+
+/* Border-box everywhere inside the author panels: 100%-width children
+   (titles, button panel, note fields) must not overflow the fixed widths. */
+#scenarioAuthorBar,
+#scenarioAuthorBar *,
+.scenarioPanel,
+.scenarioPanel *,
+.scenarioDrawer,
+.scenarioDrawer * {
+   box-sizing: border-box;
+}
+
+#scenarioAuthorBar {
+   position: fixed;
+   top: 50px;
+   right: 0;
+   z-index: 500;
+   display: flex;
+   flex-direction: column;
+   flex-wrap: nowrap;
+   background: var(--lightBlue);
+   border: 2px solid #fff;
+   border-right: 0;
+   /* border-top-left-radius: 4px; */
+   border-bottom-left-radius: 4px;
+   /* padding: 10px 10px; */
+   align-items: stretch;
+   box-shadow: 0 1px 4px rgba(0, 0, 0, .45), 0 2px 8px rgba(0, 0, 0, .15);
+   font-size: 1.0rem;
+   font-family: "Roboto Condensed", sans-serif;
+   /* fully hidden when closed (only the child tab stays visible, docked
+      flush to the panel edge); present hides all via .is-hidden.
+      No shadow when closed so translateX(100%) parks the bar exactly
+      off-screen with no bleed — the tab needs no shift in any state. */
+   transform: translateX(100%);
+   visibility: hidden;
+   pointer-events: none;
+   /* box-shadow: none; */
+   transition: transform .25s ease, visibility 0s linear .25s;
+   width: 540px;
+   max-width: 100vw;
+   max-height: 85vh;
+   overflow: visible;
+}
+
+#scenarioAuthorBar.open {
+   transform: none;
+   visibility: visible;
+   pointer-events: auto;
+   transition: transform .25s ease;
+}
+
+#scenarioAuthorBar.is-hidden {
+   transform: translateX(100%);
+   visibility: hidden;
+   pointer-events: none;
+   box-shadow: none;
+   transition: transform .25s ease, visibility 0s linear .25s;
+}
+
+#scenarioPlayBar #scExit {
+   position: absolute;
+   right: 20px;
+   font-size: 1.0rem;
+
+
+}
+
+
+#scenarioPlayBarTitle {
