+.compEye:hover {
+  color: #fff;
+  background-color: var(--darkEarth);
+}
+
+.compEye.off-state {
+  /* Dimmed via color, not opacity: opacity < 1 would create a stacking
+     context on the button and trap its tooltip below the panel again. */
+  /* color: var(--veryLightBlue); */
+}
+
+.compEye.off-state:hover {
+  color: #fff;
+}
+
+.nameCompBox.comp-hidden {
+  background-color: var(--veryLightBlue);
+  border-color: var(--lightBlue);
+  color: #fff;
+  cursor: default;
+  min-width: 1.2em;
+  text-align: center;
+}
