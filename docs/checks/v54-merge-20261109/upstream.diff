+#viewerVisBtns .settingsBtn {
+  position: static;
+  transform: none;
+}
+
+/* Viewer title-bar right cluster: [edit][new][save][gear]. The container takes
+   the single absolute slot once (v54 Stage 2: two draft entries + save + gear);
+   buttons lay out in a row inside it, mirroring #viewerVisBtns on the left. */
+#viewerSettingsBtnDiv {
+  position: absolute;
+  right: 8px;
+  top: 50%;
+  transform: translateY(-50%);
