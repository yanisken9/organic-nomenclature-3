+/* Per-component name visibility (eye toggles): each box lives in a
+   .nameCompWrap column with a fixed-height eye slot above it. The slot
+   reserves space whether eyes are shown or not, so every wrap has the same
+   height and the outside "+" separators align uniformly. Hidden boxes
+   render a dash on a lightBlue fill and ignore clicks (JS .comp-hidden). */
+.nameCompWrap {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+}
+
+.nameCompEyeRow {
+  height: 20px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+/* Separators sit outside the wraps: pinned to the wrap bottom and padded up
+   so the "+" centers on the (fixed-height) box. Tune padding-bottom by eye
+   if fonts change: (boxHeight − plusHeight) / 2 ≈ 3px. */
+.nameCompPlus,
+.nameCompSpace {
+  align-self: flex-end;
+  padding-bottom: 3px;
+}
