+body.scPinned #scenarioAuthorBar {
+   position: absolute;
+   right: 0;
+   top: -31px;
+   bottom: 0;
+   width: 480px;
+   max-width: 480px;
+   /* No transform/visibility/pointer-events here: pinned inherits the base
+       closed/.open state (transform translateX(100%) <-> none, visibility).
+       transition is forced off so CSS never races the WAAPI slide that JS
+       drives (fScenarioSlideBar); reduced-motion/no-WAAPI just snaps. */
+   transition: none;
+   /* Height is exact (top+bottom of pageContainer); the lifted 85vh cap must
+      not clamp it on tall pages — unpinned keeps the cap. Column flex from
+      the base rule lays out title + scrolling panels inside. */
+   max-height: none;
+   box-shadow: none;
+   border: 10px solid var(--darkBlue);
+   border-right: 0;
+   border-radius: 0;
+}
