+   /* min-height: 80vh; */
+   overflow-y: auto;
+   max-height: none;
+}
+
+/* Pinned horizontal-scroll cues (v48): the scroller's own bottom bar sits
+   below the fold, so edge buttons + fade + branded thumb carry
+   discoverability. All hidden unless pinned AND overflowing (.scCanScroll
+   on #mainAppContainer, managed in JS). */
+
+/* Edge buttons: viewport-anchored (top:40vh), zero flow impact. */
+#scScrollLeft,
