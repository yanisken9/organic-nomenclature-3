+/* Authoring pin-dock (v48): the bar leaves its fixed overlay and pins to
+   the right edge of #pageContainer, spanning its full height (title zone
+   through footer). #mainAppContainer holds exactly the three app columns
+   and becomes the horizontal scroller; h1 + footer yield the 480px band via
+   right margin so their text stays clear of the bar.
+   body.scPinned outranks .open/.is-hidden by specificity and comes last in
+   source order. The viewer keeps measured pixels via inline flex
+   (set/cleared in JS after a pre-dock read), so the applets never reflow.
+   The bar is absolutely positioned (out of flow) so it can never drive
+   layout height: it always equals the container's height, and tall
+   drawer content scrolls inside instead of growing the page. */
+body.scPinned #pageContainer {
+   position: relative;
+   max-width: calc(1600px + 480px);
+   margin: 0 auto;
+   height: auto;
+   min-height: calc(100% - 30px);
+   /* Inline-size query container for the adaptive pinned viewer width below
+      (100cqw = this element's content width, already excluding the scrollbar).
+      Safe in pinned mode: this element is already position:relative, and the
+      only position:fixed element (#rotatePrompt) is a direct body child. */
+   container-type: inline-size;
+}
+
+body.scPinned #pageTitle {
+   margin-right: 480px;
+}
+
+body.scPinned #creditsUs {
+   width: auto;
+   margin-right: 480px;
+}
+
+#authorLayout {
+   margin: 0 10px;
+}
+
+body.scPinned #authorLayout {
+   position: relative;
+   max-width: none;
+   margin: 0 2px 0 10px;
+}
+
+body.scPinned #mainAppContainer {
+   max-width: none;
+   margin: 0 480px 20px 0;
+   overflow-x: auto;
+}
+
+body.scPinned #mainAppContainer>.mainApp3Columns {
+   flex-wrap: nowrap;
+}
+
+/* Pinned viewer width (adaptive): the inline measured pre-dock flex-basis is
+   the upper bound (620px), and this cap keeps the row + 480px band inside the
+   page container. On wide screens the cap is 620px, so the viewer keeps its
+   original width; as the screen narrows it eases down only as far as needed,
+   with --viewerPinnedWidth (default 400px) as the floor. 100cqw resolves
+   against the pinned #pageContainer above; 1090px = band 480 + menu 230 +
+   gaps 20 + analysis 350 + viewer-border/rounding slack. The resize observer
+   picks up the change, so JSME/JSmol follow through the verified fluid path
+   with no JS change. */
+body.scPinned #viewerCol {
+   max-width: clamp(var(--viewerPinnedWidth, 400px), calc(100cqw - 1090px), 620px);
+}
