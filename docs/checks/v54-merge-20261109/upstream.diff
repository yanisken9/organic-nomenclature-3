+  if (!svg) {
+    return;
+  }
+  svg.querySelectorAll("text").forEach(function (label) {
+    if (label.textContent.trim() !== "C") {
+      return;
+    }
+    const backplate = label.previousElementSibling;
+    if (
+      backplate &&
+      backplate.localName === "rect" &&
+      backplate.hasAttribute("rx")
