+/* Expanded-name floating overlay (non-modal): the existing name boxes float
+   over the app at fit-content width and default size so long names read whole.
+   Anchored to the host's right edge, growing left outside the parent.
+   Same nodes — clicks, eyes, narration keep working; no backdrop, no dimming,
+   the app underneath stays fully interactive. Closed by its toggle, Esc, or
+   a rebuild for another molecule. */
+#nameExpandBtn[hidden] {
+  display: none;
+}
+
+#nameAnalysisContainer {
+  position: relative;
+  overflow: visible;
+}
+
+#nameAnalysisContainer.nameExpanded .nameCompContainer {
+  position: absolute;
+  right: 0px;
+  width: max-content;
+  min-width: 100%;
+  /* never smaller than host width */
+  max-width: calc(100vw - 24px);
+  /* viewport safety cap */
+  overflow-x: auto;
+  /* max-height: calc(100vh - 130px); */
+  overflow-y: hidden;
+  z-index: 800;
+  background: var(--bodyBg);
+  border: 1px solid var(--lightBlue);
+  border-radius: 3px;
+  box-shadow: 0px 2px 3px rgba(0, 0, 0, 0.55), 1px 3px 6px rgba(0, 0, 0, 0.35);
+  padding: 0 15px 18px 15px;
+  display: flex;
+  flex-wrap: nowrap;
+  row-gap: 0px;
+  align-items: center;
+  --nameCompScale: 1;
+}
+
+.nameCompBox:hover {
+  /* border-color: var(--vibrantGreen); */
+  z-index: 100;
+  background-color: var(--veryLightBlue);
+}
+
+.nameCompBox.selected {
+  color: #fff;
+  background-color: var(--vibrantGreen);
+  position: relative;
+  font-weight: bold;
+  border-color: var(--vibrantGreen);
+  /* box-shadow: 1px 1px 3px 0px rgba(0,0,0,0.5); */
+}
+
+.nameCompBox.selected.unboxed {
+  padding: 5px 4px;
+}
+
+.nameCompBox.selected::after {
+  content: "";
+  position: absolute;
+  left: calc(50% - 3px);
+  top: 100%;
+  width: 6px;
+  height: 22px;
+  background-color: var(--vibrantGreen);
+  /* box-shadow: 1px 1px 3px 0px rgba(0,0,0,0.5); */
+}
