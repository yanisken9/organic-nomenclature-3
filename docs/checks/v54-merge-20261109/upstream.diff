+    if (os.length !== 1) return false
+    const ns = (conn[os[0]] || []).filter(n => types[n] !== 'H')
+    if (ns.length !== 1 || types[ns[0]] !== 'C' ||
+        (conn[ns[0]] || []).filter(n => types[n] === 'C').length !== 2) return false
