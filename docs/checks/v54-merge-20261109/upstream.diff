+
+#scenarioPlayBarTitle button[data-tooltip]::before,
+#scenarioPlayBar button[data-tooltip]::before,
+.scenarioPanel button[data-tooltip]::before,
+.scNoteFontSizeWrap[data-tooltip]::before,
+.scShowRow .sshow[data-tooltip]::before,
