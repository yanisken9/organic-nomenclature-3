+#scenarioAuthorBar .scenarioDrawer .scNoteToolbar button.scColsToggle[data-tooltip]::after,
+#scenarioAuthorBar .scenarioDrawer .scNoteToolbar button.scTextPosBtn[data-tooltip]::after {
