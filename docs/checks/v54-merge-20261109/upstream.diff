+// mulermoc-nom-core-54.js
+// Pure analysis engine — no DOM, no jQuery.
+// Reads molecular data from JSME API / parsed SDF text.
+// Writes to shared globals consumed by mulermoc-nom-molview-53.js.
+
+// ── Analysis globals (2D) ──────────────────────────────────────────────────
