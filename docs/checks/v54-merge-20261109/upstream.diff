+        try {
+          hok = !!fScenarioApply(hps.steps[hps.index]);
+        } catch (e) {
+          hok = false;
+        }
+        if (!hok) {
+          fScenarioToast("Could not apply step " + (hps.index + 1) + ".");
+          return;
+        }
+        fScenarioPlayUi();
+        fScenarioRenderPresentMenu();
+      }
+    }
+  });
+}
+
+if (document.readyState === "loading") {
+  document.addEventListener("DOMContentLoaded", fScenarioBoot);
+} else {
+  fScenarioBoot();
+}
